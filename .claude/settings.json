      "Bash(curl:*)", "Bash(shasum:*)", "Bash(unzip:*)", "Bash(tar:*)",
      "Bash(hdiutil:*)", "Bash(codesign:*)", "Bash(otool:*)", "Bash(install_name_tool:*)",
      "Bash(dylibbundler:*)", "Bash(lipo:*)", "Bash(file:*)", "Bash(xattr:*)", "Bash(sips:*)",
      "Bash(iconutil:*)", "Bash(sandbox-exec:*)", "Bash(xcrun:*)", "Bash(xcode-select:*)",
      "Bash(open:*)", "Bash(du:*)", "Bash(find:*)", "Bash(ls:*)", "Bash(cat:*)", "Bash(grep:*)",
      "Bash(tail:*)", "Bash(head:*)", "Bash(mkdir:*)", "Bash(cp:*)", "Bash(mv:*)", "Bash(chmod:*)",
      "Bash(ln:*)", "Bash(env:*)", "Bash(zsh:*)", "Bash(bash:*)", "Bash(rm:target/*)", "Bash(rm -rf target/*)",
